# --- LLM (Groq cloud inference) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b
GROQ_ROUTER_MODEL=openai/gpt-oss-20b

# --- Qdrant ---
# Option A (Docker): keep the URL below and run `docker compose up -d`.
# Option B (no Docker): set QDRANT_URL= (empty) to use embedded on-disk mode at QDRANT_PATH.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_PATH=./qdrant_local

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480

# --- Data (relative to backend/) ---
DATA_DIR=../Medibot_Assignment_Resources/mediassist_data
